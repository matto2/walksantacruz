---
import { Image } from "astro:assets";
import MapBackground from "./MapBackground.astro";
import wharfPhoto from "../assets/wharf.jpg";
---

<section id="free-guide" class="full-bleed relative section">
  <MapBackground />
  <div class="container relative">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center gap-8">
        <div class="w-full flex-none md:max-w-xs">
          <Image
            src={wharfPhoto}
            alt="Santa Cruz Wharf"
            width={400}
            height={300}
            class="w-full h-56 rounded-xl object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="title-subsection">3 Perfect Days in Santa Cruz</h2>
          <p class="text-base md:text-lg leading-snug font-semibold text-foreground mb-5">A free local's guide for visitors and teams — yours instantly when you sign up.</p>
          <form action="https://app.kit.com/forms/9380967/subscriptions" method="post" class="w-full">
            <div class="flex flex-col sm:flex-row gap-2">
              <input
                name="email_address"
                type="email"
                placeholder="Email Address"
                required
                aria-label="Email Address"
                class="input flex-1 min-w-0 h-11 bg-card"
              />
              <button type="submit" class="btn h-11 px-5">Get the guide</button>
            </div>
            <p class="text-sm text-muted-foreground mt-2">We respect your privacy · Unsubscribe anytime</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
