              </div>
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoSuperSilver} alt="Super Silver" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
                <div>
                  <p class="text-sm text-muted-foreground">Super Silver</p>
                  <p class="text-lg font-bold leading-tight">Free crystal gift with $10+ purchase</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Within 7 Days -->
          <div>
            <h3 class="eyebrow">Within 7 Days</h3>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoHiddenPeak} alt="Hidden Peak Teahouse" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
                <div>
                  <p class="text-sm text-muted-foreground">Hidden Peak Teahouse</p>
                  <p class="text-lg font-bold leading-tight">15% off</p>
                </div>
              </div>
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoArtisans} alt="Artisans & Agency" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
                <div>
                  <p class="text-sm text-muted-foreground">Artisans & Agency</p>
                  <p class="text-lg font-bold leading-tight">10% off</p>
                </div>
              </div>
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoNicely} alt="Nicely" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
