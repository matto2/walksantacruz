    </div>
  </section> -->

  <!-- Sophia Block -->
  <section class="container section-flush-top">
    <figure class="max-w-3xl mx-auto text-center">
      <div class="flex justify-center gap-1 mb-4">
        {
          Array.from({ length: 5 }).map(() => (
            <svg class="w-5 h-5 text-yellow-500 fill-current" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          ))
        }
      </div>
      <blockquote class="text-xl md:text-2xl font-semibold leading-snug text-foreground mb-4">
        "Tours are relaxed, entertaining, enlightening, and highly recommended
        for anyone seeking a bigger, more flavorful slice of Santa Cruz
        history."
      </blockquote>
      <figcaption class="text-sm text-muted-foreground">
        — Sophia &nbsp;·&nbsp; March 2026 &nbsp;·&nbsp;
        <a href="https://share.google/xDtZXgKdz5xZL9Ruj" target="_blank" rel="noopener noreferrer" class="underline">Google Review</a>
      </figcaption>
    </figure>
  </section>

  <!-- Featured In Bar -->
  <div class="full-bleed relative py-4 md:py-6">
    <MapBackground />
    <div class="flex items-center justify-center gap-4 relative">
      <span class="title-subsection mb-0 font-display text-primary">Featured in</span>
      <a
        href="https://lookout.co/new-downtown-walking-tour-aspires-to-tell-santa-cruzs-hidden-stories/story"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Image
          src={LookoutLogo}
          alt="Lookout Santa Cruz"
          width={1179}
          height={327}
          class="h-8 md:h-12 w-auto object-contain"
        />
      </a>
    </div>
  </div>

  <!-- Reviews Section -->
  <section id="reviews" class="full-bleed relative section">
    <div class="container relative">
      <h2 class="title-section text-center">
        Guests Love Our Tours!
      </h2>

      <ReviewsCarousel
        reviews={reviews}
        airbnbLogo={airbnbLogo}
        tripadvisorLogo={tripadvisorLogo}
        viatorLogo={viatorLogo}
      />

      <p class="text-center text-sm text-muted-foreground mt-10 mb-1">⭐⭐⭐⭐⭐ 12+ five-star reviews on Google, Airbnb, TripAdvisor &amp; Viator</p>
      <p class="text-center text-sm text-muted-foreground">Questions? Call or text us at <a href="tel:8312752566" class="font-semibold text-foreground">831-275-2566</a></p>
    </div>
  </section>

  <!-- Meet Your Guide Section -->
  <section class="full-bleed relative section">
    <MapBackground />
    <div class="container relative">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-10 md:gap-16 items-center">
        <div class="flex-shrink-0">
          <Image
            src={mattBioPic}
            alt="Matt O'Leary, Walk Santa Cruz guide"
            width={320}
            height={400}
            class="rounded-xl object-cover w-56 md:w-72 h-64 md:h-80"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col gap-5">
          <h2 class="title-section mb-0">Meet Your Guide</h2>
          <p class="text-base md:text-lg leading-relaxed">
            Matt O'Leary leads history and culture walks across Santa Cruz—from the coastline and Beach Hill to downtown, the old Mission site, and surrounding Victorian neighborhoods. Each walk explores a different layer of the city, from its surf heritage to its early development and architectural character.
          </p>
          <p class="text-base md:text-lg leading-relaxed">
            A Santa Cruz surfer since the late 1970s, co-founder of <em>The Juice</em> surf magazine, and a competitor in the O'Neill Coldwater Classic, Matt pairs firsthand knowledge of the local surf scene with a deep interest in the people, places, and events that shaped the city both along the coast and in the downtown historic district.
          </p>
          <blockquote class="border-l-4 border-primary pl-4 italic text-muted-foreground">
            "Matt has extensive local history to share and also invites hearing stories from other locals and visitors." — Alison, Google Review
          </blockquote>
          <a href="/about" class="text-primary font-semibold">More About Matt →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="book" class="container section">
    <div class="max-w-2xl mx-auto text-center">
      <h3 class="title-subsection">
        Ready to Book?
      </h3>
      <p class="tagline">Pick a date to see available tours &amp; times</p>
      <script is:inline src="https://fareharbor.com/embeds/script/calendar/walksantacruz/?fallback=simple&full-items=yes"></script>
      <script is:inline>
        window.addEventListener('unload', function() {});
        window.addEventListener('pageshow', function(event) {
          if (event.persisted) { window.location.reload(); }
        });
      </script>
      <p class="text-sm font-semibold text-foreground mt-4">Full refund if cancelled 24+ hours before tour start time</p>
      <p class="text-sm text-muted-foreground mt-3">Calendar not loading? <a href="https://fareharbor.com/walksantacruz/" target="_blank" rel="noopener noreferrer" class="text-primary underline">Book directly on FareHarbor →</a></p>
    </div>
  </section>

  <!-- GIFT CARDS HIDDEN — restore by removing these comment tags
  <section class="full-bleed section bg-teal">
    <div class="container text-center text-white">
      <h2 class="title-page">🎁 Gift Cards</h2>
      <p class="text-xl md:text-2xl mb-8 font-medium">The perfect Santa Cruz gift</p>
      <a
        href="https://fareharbor.com/embeds/book/walksantacruz/items/679241/calendar/?full-items=yes"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-lg"
      >Buy a Gift Card</a>
    </div>
  </section>
  -->

  <!-- Local Perks Section -->
  <section class="full-bleed section">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="title-section text-center">
          Your Tour Includes Exclusive Local Perks
        </h2>
        <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-2">
          Enjoy discounts and special offers from favorite Santa Cruz shops,
          cafes, and downtown businesses. Each partner sets their own offer and
          redemption window.
        </p>
        <p class="text-xl font-bold text-center mb-12">
          Show your tour confirmation email to redeem.
        </p>

        <div class="space-y-10">
          <!-- Same-Day -->
          <div>
            <h3 class="eyebrow">Same-Day Perks</h3>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoMyToque} alt="MyTOQUE" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
                <div>
                  <p class="text-sm text-muted-foreground">MyTOQUE</p>
                  <p class="text-lg font-bold leading-tight">Free 100 ml olive oil with $25 purchase</p>
                </div>
              </div>
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoMoonKissed} alt="Moon Kissed" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
                <div>
                  <p class="text-sm text-muted-foreground">Moon Kissed</p>
                  <p class="text-lg font-bold leading-tight">10% off</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Within 3 Days -->
          <div>
            <h3 class="eyebrow">Within 3 Days</h3>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-card rounded-xl border p-4 flex items-center gap-4">
                <Image src={logoMythic} alt="Mythic Games" class="w-28 h-28 object-contain flex-shrink-0 rounded" loading="lazy" quality={80} />
